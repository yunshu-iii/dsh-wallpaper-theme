{
  "name": "dsh-wallpaper-theme",
  "version": "1.0.0",
  "description": "DSH Harness desktop plugin: wallpaper, glass surfaces and appearance panel for the Harness window.",
  "type": "module",
  "license": "MIT",
  "author": "yunshu-iii",
  "homepage": "https://github.com/yunshu-iii/dsh-wallpaper-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunshu-iii/dsh-wallpaper-theme.git"
  },
  "bugs": {
    "url": "https://github.com/yunshu-iii/dsh-wallpaper-theme/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "harness-plugin",
    "wallpaper",
    "theme",
    "glass",
    "desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
